{
  "name": "dsh-tavern-fate-dice",
  "version": "1.0.0",
  "description": "DSH Tavern 动态检定与真骰插件：复用叙事阻尼器决策模型毫秒级定难度，结合 R18 语义分级脱敏、crypto 真随机投骰与移动端非阻塞骰子动画。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "client.js",
    "build.mjs",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bigmalove/dsh-tavern-fate-dice.git"
  },
  "homepage": "https://github.com/bigmalove/dsh-tavern-fate-dice#readme",
  "bugs": {
    "url": "https://github.com/bigmalove/dsh-tavern-fate-dice/issues"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    },
    "compatibility": {
      "tavernApiVersion": 8
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "build:check": "node build.mjs --check",
    "test": "node --test tests/*.test.mjs"
  },
  "license": "MIT"
}
