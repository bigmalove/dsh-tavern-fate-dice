{
  "name": "dsh-tavern-fate-dice",
  "version": "2.0.0",
  "description": "DSH Tavern 命运之骰工作台：插件区常驻面板、无感自动技能检定（内置12套世界观样板）、叙事阻尼器单趟双向联动、多轨随机事件池与剧情增强3.2（冷却/屏蔽/持续剧情线/JSON导入导出）。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "client.js",
    "build.mjs",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bigmalove/dsh-tavern-fate-dice.git"
  },
  "homepage": "https://github.com/bigmalove/dsh-tavern-fate-dice#readme",
  "bugs": {
    "url": "https://github.com/bigmalove/dsh-tavern-fate-dice/issues"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "dsh-tavern-plugin"
      ]
    },
    "compatibility": {
      "tavernApiVersion": 8
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "build:check": "node build.mjs --check",
    "test": "node --test tests/*.test.mjs"
  },
  "license": "MIT"
}
